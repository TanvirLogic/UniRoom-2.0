# UniRoom-Live 2.0 Backend Environment Configuration Template
PORT=3000
NODE_ENV=development

# PostgreSQL Connection String (Neon.tech or Local Docker)
DATABASE_URL="postgresql://user:password@localhost:5432/uniroom_db?sslmode=prefer"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="your_access_token_secret_key_minimum_32_characters"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="your_refresh_token_secret_key_minimum_32_characters"
JWT_REFRESH_EXPIRATION="7d"

# SMTP Configuration (Gmail SMTP with App Password)
# Note: Google requires a 16-character App Password (not your normal Gmail password)
# Generated from: Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-google-app-password"
EMAIL_FROM="UniRoom-Live <no-reply@uniroom.live>"

# Firebase Cloud Messaging (FCM) Push Notifications
# Run "npm run generate:firebase-env" in the backend directory to automatically generate these strings
# Option 1 (Recommended for Render): Base64 encoded JSON
FIREBASE_SERVICE_ACCOUNT_BASE64=""
# Option 2: Minified JSON string
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Option 3: Discrete variables
# FIREBASE_PROJECT_ID="uniroom-live"
# FIREBASE_CLIENT_EMAIL="uniroom-push@uniroom-live.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
