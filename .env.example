# ==============================================================================
# UniRoom-Live 2.0 - Environment Configuration Template
# Copy this file to .env before running the application locally:
#   cp .env.example .env
# ==============================================================================

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL Database
POSTGRES_USER=uniroom_admin
POSTGRES_PASSWORD=uniroom_secret_pass
POSTGRES_DB=uniroom_live
POSTGRES_PORT=5432
DATABASE_URL=postgresql://uniroom_admin:uniroom_secret_pass@localhost:5432/uniroom_live?schema=public

# Redis In-Memory Cache & Pub/Sub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_ACCESS_SECRET=super_secret_jwt_access_key_change_in_prod_at_least_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_prod_at_least_32_chars
JWT_REFRESH_EXPIRATION=7d

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000
